<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);MEAI001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Nuget">
    <Description>Generated C# SDK for SmallestAI -- Lightning TTS, Pulse STT with speaker diarization, realtime WebSocket streaming, voice cloning, and pronunciation dictionaries.</Description>
    <PackageTags>smallestai;pulse;lightning;tts;text-to-speech;stt;speech-to-text;diarization;realtime;websocket;ispeechtotextclient;meai;voice;cloning;api;sdk;dotnet;openapi;asyncapi;autosdk</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
  </ItemGroup>

</Project>
